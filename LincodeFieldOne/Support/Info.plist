<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>FIELD ONE</string>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to ENDLESSRIVER FIELD ONE and show its live inspection video.</string>
	<key>NSCameraUsageDescription</key>
	<string>Use this iPhone camera as an inspection source when FIELD ONE hardware is not attached.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save annotated inspection frames to your photo library.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_rtsp._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
